{
  "manifest_version": "2.0",
  "name": "LibreOffice",
  "description": "The free and open source office suite.",
  "version": "26.2.4.2",
  "image": "ghcr.io/containerpak/libreoffice:main",
  "binaries": ["/usr/bin/libreoffice"],
  "desktop_entries": ["/usr/share/applications/libreoffice-startcenter.desktop"],
  "dependencies": [],
  "addons": [],
  "idle_time": 0,
  "override": {
    "socketX11": true,
    "socketWayland": true,
    "socketPulseAudio": true,
    "socketSessionBus": true,
    "socketSystemBus": false,
    "socketSshAgent": false,
    "socketCups": true,
    "socketGpgAgent": false,
    "socketAtSpiBus": true,
    "socketBluetooth": false,
    "deviceDri": true,
    "deviceKvm": false,
    "deviceShm": true,
    "deviceAlsa": false,
    "deviceVideo": false,
    "deviceFuse": false,
    "deviceTun": false,
    "deviceUsb": false,
    "deviceAll": false,
    "notification": false,
    "fsHost": false,
    "fsHostEtc": false,
    "fsHostHome": true,
    "fsExtra": [],
    "env": [],
    "network": true,
    "process": false,
    "asRoot": false,
    "allowedHostCommands": ["xdg-open"]
  }
}
